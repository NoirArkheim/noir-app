#!/bin/bash
# Двойной щелчок в Finder — выпуск откроется в браузере.
# Работает только на этом компьютере, в интернет ничего не выкладывается.
# Чтобы остановить, закройте окно Терминала.
cd "$(dirname "$0")" || exit 1
PORT=8765
(sleep 1; open "http://localhost:$PORT/") &
echo "Выпуск открыт: http://localhost:$PORT/  — чтобы остановить, закройте это окно."
python3 -m http.server "$PORT" --bind 127.0.0.1
